<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下：禁用应用数据备份（登录 Cookie / 本地存储不入云备份） -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
