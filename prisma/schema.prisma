// 一站式个人数字工作台 — Prisma Schema（第一阶段 MVP）
// 规则：一切结构变更走 Migration；业务表必须带 userId 外键与索引（数据隔离的物理保障）。
// 标注「预留」的模型仅作占位声明，本期不实现业务，避免将来命名冲突。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

enum Role {
  ADMIN
  USER
  GUEST
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ColorMode {
  LIGHT
  DARK
  SYSTEM
}

enum CodePurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ---------- 博客板块（阶段二）----------

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum AuditStatus {
  PENDING
  PASSED
  REJECTED
}

/// 标签作用域：任务标签与博客标签共用 Tag 表，靠 scope 隔离（约束放松式迁移）
enum TagScope {
  TASK
  POST
}

enum SensitiveLevel {
  BLOCK
  REVIEW
  MASK
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

// ---------- 通知中心 / 社交（2026-10 版本）----------

enum NotificationType {
  /// 博客文章收到点赞
  POST_LIKE
  /// 文章收到评论
  POST_COMMENT
  /// 评论被回复
  COMMENT_REPLY
  /// 被关注
  FOLLOW
  /// 收到私聊消息
  MESSAGE
  /// 系统通知
  SYSTEM
}

// ---------- 用户与认证 ----------

model User {
  id              String     @id @default(cuid())
  /// 统一小写存储（zhang_san 与 Zhang_San 视为同一用户）
  username        String     @unique
  /// 统一小写存储
  email           String     @unique
  /// Argon2id 哈希；OAuth 注册用户可为空。密码永不落明文
  passwordHash    String?
  displayName     String?
  avatarUrl       String?
  /// 个人简介（我的空间展示，≤200 字）
  bio             String?    @db.VarChar(200)
  /// 我的空间封面图 URL
  coverImage      String?
  role            Role       @default(USER)
  emailVerifiedAt DateTime?
  /// IANA 时区名（如 Asia/Shanghai）
  timezone        String     @default("Asia/Shanghai")
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions               Session[]
  setting                UserSetting?
  tasks                  Task[]
  tags                   Tag[]
  habits                 Habit[]
  habitLogs              HabitLog[]
  authAccounts           AuthAccount[]
  posts                  BlogPost[]
  comments               Comment[]
  postLikes              PostLike[]
  reposts                PostRepost[]
  commentLikes           CommentLike[]
  notifications          Notification[]   @relation("notificationRecipient")
  triggeredNotifies      Notification[]   @relation("notificationActor")
  followerLinks          Follow[]         @relation("followFollower")
  followingLinks         Follow[]         @relation("followFollowing")
  conversationsInitiated Conversation[]   @relation("conversationInitiator")
  conversationsJoined    Conversation[]   @relation("conversationJoined")
  directMessages         DirectMessage[]
  shortLinks             ShortLink[]
  bookmarks              Bookmark[]
  featureRequests        FeatureRequest[]
  badge                  UserBadge?
  systemMessages         SystemMessage[]
  adminSessions          AdminSession[]
  blockedContents        BlockedContent[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  userAgent    String?
  /// IP 哈希存储，不存明文
  ipHash       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationCode {
  id         String      @id @default(cuid())
  email      String
  /// 存哈希不存明文
  codeHash   String
  purpose    CodePurpose
  expiresAt  DateTime
  consumedAt DateTime?
  /// 失败次数，≥5 作废
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([email, purpose, createdAt])
}

model UserSetting {
  userId        String    @id
  themeName     String    @default("aurora")
  colorMode     ColorMode @default(SYSTEM)
  weekStartDay  Int       @default(1)
  notifyEmail   Boolean   @default(false)
  reminderTime  String?
  locale        String    @default("zh-CN")
  /// comfortable | compact
  density       String    @default("comfortable")
  /// small | medium | large
  fontSize      String    @default("medium")
  motionEnabled Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 第三方登录占位：本期不写入数据，仅建表
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessTokenRef    String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// 数据库计数限流桶（阶段三迁 Redis）
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// ---------- 管理后台（2026-10）----------

/// 用户称号（认证标识）：管理端自定义文字与配色；评论区/空间等名片处展示，
/// 持有者头像右下角叠加 S 角标。
model UserBadge {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// 称号文字（≤20 字）
  text      String   @db.VarChar(20)
  /// 文字/边框色（hex）
  color     String   @db.VarChar(16)
  /// 背景色（hex；空=透明底）
  bgColor   String?  @db.VarChar(16)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 站内弹窗公告：用户端进入平台时弹出（按用户本地记忆已读）
model Announcement {
  id        String    @id @default(cuid())
  title     String    @db.VarChar(200)
  content   String    @db.VarChar(2000)
  /// info | warning | critical（影响弹窗配色）
  level     String    @default("info")
  /// 是否展示
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// 平台功能开关：管理端一键启停用户端板块
model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(true)
  /// 停用原因（展示给用户）
  disabledReason String?  @db.VarChar(200)
  updatedAt      DateTime @updatedAt
}

/// 系统私信：管理端发给指定用户的官方消息（用户端「系统信息」栏统一展示）
model SystemMessage {
  id        String    @id @default(cuid())
  userId    String
  title     String    @db.VarChar(200)
  content   String    @db.VarChar(2000)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

/// 管理员会话：与用户会话（Session）完全隔离，独立 Cookie（pwb_admin）。
/// 登录需双因子：账号密码 + 服务器下发密钥（ADMIN_ACCESS_KEY）。
model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  /// 双因子通过时间（审计）
  grantedAt DateTime @default(now())
  expiresAt DateTime
  ipHash    String?
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 自动审查阻断记录：命中 BLOCK 级违禁词的内容存档，供管理端审查处置
model BlockedContent {
  id           String   @id @default(cuid())
  userId       String
  /// post | comment | message
  kind         String   @db.VarChar(20)
  /// 内容快照（≤2000 字）
  content      String   @db.VarChar(2000)
  matchedWords Json?
  /// pending | dismissed
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
}

/// 需求反馈（意见征集）：未开放板块「想要什么功能，告诉我们」提交内容。
/// 同时追加写入 feedback/意见征集.md（文件侧归档），后台 /feedback 页面可随时查看。
model FeatureRequest {
  id         String   @id @default(cuid())
  /// 提交者（登录用户；未登录为 null）
  userId     String?
  /// 提交者展示名（快照，防用户改名后无法追溯）
  authorName String   @db.VarChar(100)
  /// 来源板块（如 问卷 / 视频下载 / AI 预览）
  source     String   @db.VarChar(100)
  content    String   @db.VarChar(2000)
  /// "NEW" | "PLANNED" | "DONE"（后台标记）
  status     String   @default("NEW")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
}

/// 后台任务表（JobRunner 适配器载体；本期不接 Cron 触发）
model Job {
  id          String    @id @default(cuid())
  type        String
  payloadJson String
  status      String    @default("pending")
  runAt       DateTime  @default(now())
  ranAt       DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
}

// ---------- 任务清单 ----------

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  /// 截止时刻（UTC 存储；由客户端按用户时区提交的日期串换算）
  dueAt       DateTime?
  priority    Priority  @default(MEDIUM)
  sortOrder   Int       @default(0)
  /// RRULE 字符串，阶段二启用（只存不解析）
  repeatRule  String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags TaskTag[]

  @@index([userId, completed, dueAt])
  @@index([userId, deletedAt])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  /// 标签作用域：TASK（任务清单）/ POST（博客文章）。所有查询必须显式带 scope（仓储层不提供无 scope 方法）
  scope     TagScope @default(TASK)
  name      String
  color     String   @default("#6366F1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]
  postLinks PostTag[]

  @@unique([userId, scope, name])
  @@index([userId, scope])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

// ---------- 习惯打卡 ----------

model Habit {
  id            String    @id @default(cuid())
  userId        String
  name          String
  description   String?
  color         String    @default("#4A7C59")
  icon          String    @default("flame")
  targetPerWeek Int       @default(7)
  sortOrder     Int       @default(0)
  /// 归档：从列表隐藏但保留全部历史数据
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, deletedAt])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  /// 冗余存 userId，便于按用户聚合，避免多一次 join
  userId    String
  /// 用户时区下的打卡日期（仅年月日），核心字段。语义是“这一天有没有打卡”
  logDate   DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 保证打卡幂等：同一习惯同一天只有一条记录
  @@unique([habitId, logDate])
  @@index([userId, logDate])
}

// ---------- 预留模型（阶段二+，未启用；仅声明以固化命名规范） ----------

// ---------- 博客（阶段二落地）----------

/// 文章主体。contentMd 为唯一真源；contentHtml 为服务端预渲染缓存（供 RSS 与 SSG 复用）
model BlogPost {
  id             String         @id @default(cuid())
  userId         String
  /// 全局唯一 URL 标识；改标题不自动改 slug（避免已收录链接失效）
  slug           String         @unique
  title          String
  excerpt        String?        @db.VarChar(300)
  contentMd      String         @db.Text
  contentHtml    String?        @db.Text
  /// 目录（h2/h3 抽取结果）。与 contentHtml 同源同事务写入——
  /// 详情页是 ISR，不能每次请求都重新解析 Markdown，故随渲染结果一并固化。
  toc            Json?
  coverImage     String?
  status         PostStatus     @default(DRAFT)
  visibility     PostVisibility @default(PUBLIC)
  /// 仅 PASSED 可 PUBLISHED（审核门禁）
  auditStatus    AuditStatus    @default(PENDING)
  /// 审核意见（驳回原因），作者可见
  auditNote      String?
  /// 首次发布时间；编辑已发布文章不更新此值
  publishedAt    DateTime?
  seoTitle       String?        @db.VarChar(60)
  seoDesc        String?        @db.VarChar(160)
  ogImage        String?
  canonicalUrl   String?
  wordCount      Int            @default(0)
  /// 中文按 400 字/分钟估算，最少 1
  readingMinutes Int            @default(1)
  viewCount      Int            @default(0)
  /// 冗余计数：与明细表同事务更新（对账脚本兜底）
  likeCount      Int            @default(0)
  commentCount   Int            @default(0)
  repostCount    Int            @default(0)
  shareCount     Int            @default(0)
  allowComment   Boolean        @default(true)
  allowRepost    Boolean        @default(true)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  Comment[]
  tags      PostTag[]
  likes     PostLike[]
  reposts   PostRepost[]
  views     PostView[]
  bookmarks Bookmark[]   @relation("BookmarkPost")

  @@index([userId, status, deletedAt])
  @@index([status, visibility, publishedAt(sort: Desc)])
  @@index([status, visibility, likeCount(sort: Desc)])
  @@index([auditStatus])
}

/// 两级楼中楼评论：parentId 只允许指向顶层评论，写入时自动上提（深度恒 ≤2）
model Comment {
  id          String        @id @default(cuid())
  postId      String
  userId      String
  parentId    String?
  content     String        @db.Text
  status      CommentStatus @default(PENDING)
  auditStatus AuditStatus   @default(PENDING)
  likeCount   Int           @default(0)
  /// 软删除：保留"该评论已删除"占位，避免楼层错乱
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, status, createdAt])
  @@index([parentId])
  @@index([userId])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PostRepost {
  postId    String
  userId    String
  /// 转发语 ≤200 字
  comment   String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

/// 浏览去重：viewerHash 为 IP+UA 哈希（不存原始 IP，与 Session.ipHash 一致）
model PostView {
  id         String   @id @default(cuid())
  postId     String
  viewerHash String
  viewDate   DateTime @db.Date
  createdAt  DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerHash, viewDate])
  @@index([postId, viewDate])
}

model PostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model SensitiveWord {
  id        String         @id @default(cuid())
  word      String         @unique
  level     SensitiveLevel @default(REVIEW)
  category  String?
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@index([enabled, level])
}

model AuditRecord {
  id           String   @id @default(cuid())
  /// "POST" | "COMMENT"
  targetType   String
  targetId     String
  /// "SUBMIT" | "PASS" | "REJECT" | "MASK"
  action       String
  matchedWords Json?
  reviewerId   String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------- 通知中心（2026-10）----------

/// 站内通知：博客互动（点赞/评论/回复）、关注、私聊、系统广播。
/// link 携带跳转锚点（如 /blog/p/xxx#comment-yyy），前端跳转后高亮对应评论。
model Notification {
  id        String           @id @default(cuid())
  /// 接收者
  userId    String
  /// 触发者（系统通知为 null）
  actorId   String?
  type      NotificationType
  title     String           @db.VarChar(200)
  content   String?          @db.VarChar(500)
  /// 站内跳转链接（含锚点）
  link      String?          @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation("notificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("notificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, type])
}

/// 关注关系：followerId 关注 followingId
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("followFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
}

/// 私聊会话：两个用户一对一。userAId 为发起者（保证 userAId < userBId 字典序可另做约束，
/// 这里用显式 unique([userAId, userBId]) + 查询时双向匹配保证幂等）
model Conversation {
  id            String   @id @default(cuid())
  userAId       String
  userBId       String
  /// 冗余：会话列表按此排序，避免每次 join messages 取最新时间
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userA    User            @relation("conversationInitiator", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User            @relation("conversationJoined", fields: [userBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt(sort: Desc)])
  @@index([userBId, lastMessageAt(sort: Desc)])
}

/// 私聊消息：文字或图片（二选一，图片走存储抽象与博客同管线）
model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String?   @db.VarChar(2000)
  /// 图片 URL（上传管线校验大小/类型）
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
}

/// 短链（2026-10 落地）：支持 URL 短链与文件/图片分享短链
model ShortLink {
  id          String    @id @default(cuid())
  userId      String
  /// 短码（Base62，全局唯一）
  slug        String    @unique
  /// url = 普通链接短链；file = 文件/图片分享
  kind        String    @default("url")
  /// 目标链接（kind=url 必填）
  targetUrl   String?   @db.Text
  /// 文件存储 key（kind=file 使用，与博客图片同存储抽象）
  fileKey     String?
  /// 原始文件名（下载时还原）
  fileName    String?   @db.VarChar(255)
  mimeType    String?   @db.VarChar(100)
  fileSize    Int?
  /// 标题与备注（管理列表展示）
  title       String?   @db.VarChar(200)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  clickCount  Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits LinkVisit[]

  @@index([userId, createdAt(sort: Desc)])
}

/// 短链访问明细：IP 哈希脱敏（与 Session.ipHash 同口径）
model LinkVisit {
  id        String   @id @default(cuid())
  linkId    String
  ipHash    String?
  userAgent String?  @db.VarChar(500)
  referer   String?  @db.VarChar(500)
  country   String?
  visitedAt DateTime @default(now())

  link ShortLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, visitedAt])
}

/// 书签（2026-10 落地）：网站收藏 + 博客文章收藏，文件夹/标签/星标/备注
model Bookmark {
  id          String    @id @default(cuid())
  userId      String
  url         String    @db.Text
  title       String    @db.VarChar(300)
  /// link = 网站；post = 站内博客文章
  kind        String    @default("link")
  favicon     String?   @db.VarChar(500)
  /// 摘要（书签详情与搜索展示）
  description String?   @db.VarChar(500)
  /// 收藏夹（文件夹）
  folder      String    @default("默认收藏") @db.VarChar(100)
  /// 标签（PostgreSQL 原生数组）
  tags        String[]
  isFavorite  Boolean   @default(false)
  /// 个人备注
  note        String?   @db.Text
  /// 归档：从主列表隐藏但保留
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 站内文章收藏（kind=post），文章删除置空
  post   BlogPost? @relation("BookmarkPost", fields: [postId], references: [id], onDelete: SetNull)
  postId String?

  @@index([userId, deletedAt, createdAt(sort: Desc)])
  @@index([userId, folder])
  @@index([userId, kind])
}

/// 预留：问卷（阶段五）
model Survey {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String   @default("DRAFT")
  isAnonymous Boolean  @default(true)
  schemaJson  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 预留：问卷回执（阶段五）
model SurveyResponse {
  id             String   @id @default(cuid())
  surveyId       String
  respondentHash String?
  answersJson    String
  submittedAt    DateTime @default(now())

  @@index([surveyId])
}
