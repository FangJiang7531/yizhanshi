// 一站式个人数字工作台 — Prisma Schema（第一阶段 MVP）
// 规则：一切结构变更走 Migration；业务表必须带 userId 外键与索引（数据隔离的物理保障）。
// 标注「预留」的模型仅作占位声明，本期不实现业务，避免将来命名冲突。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

enum Role {
  ADMIN
  USER
  GUEST
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ColorMode {
  LIGHT
  DARK
  SYSTEM
}

enum CodePurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ---------- 博客板块（阶段二）----------

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum AuditStatus {
  PENDING
  PASSED
  REJECTED
}

/// 标签作用域：任务标签与博客标签共用 Tag 表，靠 scope 隔离（约束放松式迁移）
enum TagScope {
  TASK
  POST
}

enum SensitiveLevel {
  BLOCK
  REVIEW
  MASK
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

// ---------- 用户与认证 ----------

model User {
  id              String     @id @default(cuid())
  /// 统一小写存储（zhang_san 与 Zhang_San 视为同一用户）
  username        String     @unique
  /// 统一小写存储
  email           String     @unique
  /// Argon2id 哈希；OAuth 注册用户可为空。密码永不落明文
  passwordHash    String?
  displayName     String?
  avatarUrl       String?
  role            Role       @default(USER)
  emailVerifiedAt DateTime?
  /// IANA 时区名（如 Asia/Shanghai）
  timezone        String     @default("Asia/Shanghai")
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions     Session[]
  setting      UserSetting?
  tasks        Task[]
  tags         Tag[]
  habits       Habit[]
  habitLogs    HabitLog[]
  authAccounts AuthAccount[]
  posts        BlogPost[]
  comments     Comment[]
  postLikes    PostLike[]
  reposts      PostRepost[]
  commentLikes CommentLike[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  userAgent    String?
  /// IP 哈希存储，不存明文
  ipHash       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationCode {
  id         String      @id @default(cuid())
  email      String
  /// 存哈希不存明文
  codeHash   String
  purpose    CodePurpose
  expiresAt  DateTime
  consumedAt DateTime?
  /// 失败次数，≥5 作废
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([email, purpose, createdAt])
}

model UserSetting {
  userId        String    @id
  themeName     String    @default("classic-paper")
  colorMode     ColorMode @default(SYSTEM)
  weekStartDay  Int       @default(1)
  notifyEmail   Boolean   @default(false)
  reminderTime  String?
  locale        String    @default("zh-CN")
  /// comfortable | compact
  density       String    @default("comfortable")
  /// small | medium | large
  fontSize      String    @default("medium")
  motionEnabled Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 第三方登录占位：本期不写入数据，仅建表
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessTokenRef    String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// 数据库计数限流桶（阶段三迁 Redis）
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

/// 后台任务表（JobRunner 适配器载体；本期不接 Cron 触发）
model Job {
  id          String    @id @default(cuid())
  type        String
  payloadJson String
  status      String    @default("pending")
  runAt       DateTime  @default(now())
  ranAt       DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
}

// ---------- 任务清单 ----------

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  /// 截止时刻（UTC 存储；由客户端按用户时区提交的日期串换算）
  dueAt       DateTime?
  priority    Priority  @default(MEDIUM)
  sortOrder   Int       @default(0)
  /// RRULE 字符串，阶段二启用（只存不解析）
  repeatRule  String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags TaskTag[]

  @@index([userId, completed, dueAt])
  @@index([userId, deletedAt])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  /// 标签作用域：TASK（任务清单）/ POST（博客文章）。所有查询必须显式带 scope（仓储层不提供无 scope 方法）
  scope     TagScope @default(TASK)
  name      String
  color     String   @default("#6366F1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]
  postLinks PostTag[]

  @@unique([userId, scope, name])
  @@index([userId, scope])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

// ---------- 习惯打卡 ----------

model Habit {
  id            String    @id @default(cuid())
  userId        String
  name          String
  description   String?
  color         String    @default("#4A7C59")
  icon          String    @default("flame")
  targetPerWeek Int       @default(7)
  sortOrder     Int       @default(0)
  /// 归档：从列表隐藏但保留全部历史数据
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, deletedAt])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  /// 冗余存 userId，便于按用户聚合，避免多一次 join
  userId    String
  /// 用户时区下的打卡日期（仅年月日），核心字段。语义是“这一天有没有打卡”
  logDate   DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 保证打卡幂等：同一习惯同一天只有一条记录
  @@unique([habitId, logDate])
  @@index([userId, logDate])
}

// ---------- 预留模型（阶段二+，未启用；仅声明以固化命名规范） ----------

// ---------- 博客（阶段二落地）----------

/// 文章主体。contentMd 为唯一真源；contentHtml 为服务端预渲染缓存（供 RSS 与 SSG 复用）
model BlogPost {
  id             String         @id @default(cuid())
  userId         String
  /// 全局唯一 URL 标识；改标题不自动改 slug（避免已收录链接失效）
  slug           String         @unique
  title          String
  excerpt        String?        @db.VarChar(300)
  contentMd      String         @db.Text
  contentHtml    String?        @db.Text
  coverImage     String?
  status         PostStatus     @default(DRAFT)
  visibility     PostVisibility @default(PUBLIC)
  /// 仅 PASSED 可 PUBLISHED（审核门禁）
  auditStatus    AuditStatus    @default(PENDING)
  /// 审核意见（驳回原因），作者可见
  auditNote      String?
  /// 首次发布时间；编辑已发布文章不更新此值
  publishedAt    DateTime?
  seoTitle       String?        @db.VarChar(60)
  seoDesc        String?        @db.VarChar(160)
  ogImage        String?
  canonicalUrl   String?
  wordCount      Int            @default(0)
  /// 中文按 400 字/分钟估算，最少 1
  readingMinutes Int            @default(1)
  viewCount      Int            @default(0)
  /// 冗余计数：与明细表同事务更新（对账脚本兜底）
  likeCount      Int            @default(0)
  commentCount   Int            @default(0)
  repostCount    Int            @default(0)
  shareCount     Int            @default(0)
  allowComment   Boolean        @default(true)
  allowRepost    Boolean        @default(true)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]
  tags     PostTag[]
  likes    PostLike[]
  reposts  PostRepost[]
  views    PostView[]

  @@index([userId, status, deletedAt])
  @@index([status, visibility, publishedAt(sort: Desc)])
  @@index([status, visibility, likeCount(sort: Desc)])
  @@index([auditStatus])
}

/// 两级楼中楼评论：parentId 只允许指向顶层评论，写入时自动上提（深度恒 ≤2）
model Comment {
  id          String        @id @default(cuid())
  postId      String
  userId      String
  parentId    String?
  content     String        @db.Text
  status      CommentStatus @default(PENDING)
  auditStatus AuditStatus   @default(PENDING)
  likeCount   Int           @default(0)
  /// 软删除：保留"该评论已删除"占位，避免楼层错乱
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  post    BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, status, createdAt])
  @@index([parentId])
  @@index([userId])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PostRepost {
  postId    String
  userId    String
  /// 转发语 ≤200 字
  comment   String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

/// 浏览去重：viewerHash 为 IP+UA 哈希（不存原始 IP，与 Session.ipHash 一致）
model PostView {
  id         String   @id @default(cuid())
  postId     String
  viewerHash String
  viewDate   DateTime @db.Date
  createdAt  DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, viewerHash, viewDate])
  @@index([postId, viewDate])
}

model PostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model SensitiveWord {
  id        String         @id @default(cuid())
  word      String         @unique
  level     SensitiveLevel @default(REVIEW)
  category  String?
  enabled   Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@index([enabled, level])
}

model AuditRecord {
  id           String   @id @default(cuid())
  /// "POST" | "COMMENT"
  targetType   String
  targetId     String
  /// "SUBMIT" | "PASS" | "REJECT" | "MASK"
  action       String
  matchedWords Json?
  reviewerId   String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// 预留：URL 短链（阶段三）
model ShortLink {
  id         String    @id @default(cuid())
  userId     String
  slug       String    @unique
  targetUrl  String
  expiresAt  DateTime?
  clickCount Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// 预留：短链访问明细（阶段三）
model LinkVisit {
  id        String   @id @default(cuid())
  linkId    String
  ipHash    String?
  userAgent String?
  referer   String?
  country   String?
  visitedAt DateTime @default(now())

  @@index([linkId, visitedAt])
}

/// 预留：书签（阶段四）
model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  url         String
  title       String
  favicon     String?
  description String?
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

/// 预留：问卷（阶段五）
model Survey {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String   @default("DRAFT")
  isAnonymous Boolean  @default(true)
  schemaJson  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 预留：问卷回执（阶段五）
model SurveyResponse {
  id             String   @id @default(cuid())
  surveyId       String
  respondentHash String?
  answersJson    String
  submittedAt    DateTime @default(now())

  @@index([surveyId])
}
