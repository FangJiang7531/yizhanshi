# ============================================================================
# 环境变量模板 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 本文件只放占位值，任何真实密钥都不得提交进仓库（.env 已被 .gitignore 忽略）。
# 所有变量在 src/config/env.ts 启动时集中校验，缺失即快速失败退出。
# 可选字段留空（VAR=""）等同未配置。
# ============================================================================

# ---------- 数据库 ----------
# 本地开发（内嵌 PostgreSQL，npm run db:up 启动后使用 5433 端口）
DATABASE_URL="postgresql://pwb:pwb_dev_password@localhost:5433/personal_workbench_dev"
# Docker Compose 环境使用服务名 postgres:5432
# DATABASE_URL="postgresql://pwb:${POSTGRES_PASSWORD}@postgres:5432/personal_workbench"

# ---------- 认证 ----------
# 生成方式：openssl rand -base64 32（生产务必替换）
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# ---------- 应用 ----------
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="debug"

# ---------- 邮件 ----------
# SMTP 三要素（HOST/USER/PASS）齐备时验证码走真实邮件；留空则打印服务端控制台（开发/E2E 用）
# QQ/Foxmail 邮箱示例：host=smtp.qq.com，port=465（SSL）；授权码在邮箱「设置-账号-POP3/SMTP服务」生成
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# 发件人；留空时自动使用 SMTP_USER（QQ/Foxmail 要求 From 与认证账号一致）
MAIL_FROM=""

# ---------- 存储 ----------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"
# STORAGE_DRIVER="s3" 时启用
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- 工具服务（阶段六接入，本期留空即可） ----------
TOOL_SERVICE_DOWNLOADER_URL=""
TOOL_SERVICE_DOCCONVERT_URL=""
TOOL_SERVICE_TOKEN=""

# ---------- 定时任务 ----------
CRON_SECRET=""

# ---------- 博客板块（阶段二；全部有合理默认值，可整段留空） ----------
# 单张图片上传大小上限（MB）
BLOG_IMAGE_MAX_SIZE_MB="5"
# 单用户图片累计配额（MB）
BLOG_USER_QUOTA_MB="500"
# 全站与作者 RSS feed 的条数上限
BLOG_RSS_ITEM_LIMIT="20"
# 单用户单文章每分钟评论数上限（超出返回 429）
BLOG_COMMENT_RATE_LIMIT="10"
# 新注册用户冷静期（小时）：期间发表的评论直接进入人工审核队列
BLOG_NEW_USER_COOLDOWN_HOURS="24"
